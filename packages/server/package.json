{
  "name": "pawbook-server",
  "version": "2.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "npx ts-node-dev --respawn --transpile-only --ignore-watch node_modules -r tsconfig-paths/register src/server.ts",
    "prebuild": "node convert-to-relative.js",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node restore-aliases.js",
    "build:production": "node convert-to-relative.js && prisma generate && tsc -p tsconfig.json && prisma migrate deploy",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "argon2": "^0.44.0",
    "awilix": "^12.0.5",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.21.0",
    "multer": "^2.0.2",
    "save-prod": "^1.0.0",
    "zod": "^3.25.76"
  }
}
