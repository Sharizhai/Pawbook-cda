' ========== RELATIONS ==========

' Relations entre entités
User "1" -- "0..*" Animal : owns >
User "1" -- "0..*" Post : authors >
User "1" -- "0..*" Comment : writes >
User "1" -- "0..*" Like : gives >
Post "1" -- "0..*" Comment : contains >
Post "1" -- "0..*" Like : receives >
Animal "1" -- "0..*" Like : receives >
User "1" -- "0..*" Follow : follower
User "1" -- "0..*" Follow : following

' Relation avec enum
User --> Role : has

' Relations repositories
IUserRepository ..> User : manages
IAnimalRepository ..> Animal : manages
IPostRepository ..> Post : manages
ICommentRepository ..> Comment : manages
ILikeRepository ..> Like : manages
IFollowRepository ..> Follow : manages

' Implémentations
InMemoryUserRepository ..|> IUserRepository : implements
PostgresUserRepository ..|> IUserRepository : implements

InMemoryPostRepository ..|> IPostRepository : implements
PostgresPostRepository ..|> IPostRepository : implements

InMemoryAnimalRepository ..|> IAnimalRepository : implements
PostgresAnimalRepository ..|> IAnimalRepository : implements

InMemoryCommentRepository ..|> ICommentRepository : implements
PostgresCommentRepository ..|> ICommentRepository : implements

InMemoryLikeRepository ..|> ILikeRepository : implements
PostgresLikeRepository ..|> ILikeRepository : implements

InMemoryFollowRepository ..|> IFollowRepository : implements
PostgresFollowRepository ..|> IFollowRepository : implements

' Notes et contraintes
note right of Follow
  Contrainte : unique(followerId, followingId)
  Un user ne peut follow qu'une fois un autre user
end note

note right of Like
  Contrainte : unique(authorId, postId)
  Contrainte : unique(authorId, animalId)
  Un user ne peut liker qu'une fois
  une même ressource
end note

@enduml