{
  "name": "pawbook-client",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run compile-localization && vite --host",
    "test": "vitest run",
    "watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "report-coverage": "codecov",
    "build": "pnpm run compile-localization && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vite build",
    "compile-localization": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@inlang/cli": "^3.1.4",
    "@inlang/paraglide-js": "2.0.10",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.2.2",
    "@vitest/coverage-istanbul": "^3.2.4",
    "codecov": "^3.8.3",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "svelte": "^5.48.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "sass": "^1.97.3",
    "svelte-preprocess": "^6.0.3",
    "svelte-spa-router": "^4.0.1"
  }
}
