{
  "name": "pawbook-client",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run compile-localization && vite --host",
    "test": "vitest run",
    "watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "report-coverage": "codecov",
    "build": "pnpm run compile-localization && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vite build",
    "compile-localization": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@inlang/cli": "^3.1.8",
    "@inlang/paraglide-js": "2.15.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.3.5",
    "@vitest/coverage-istanbul": "^4.1.2",
    "esbuild": "^0.27.4",
    "jsdom": "^26.1.0",
    "svelte": "^5.53.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "sass": "^1.98.0",
    "svelte-spa-router": "^4.0.1"
  }
}
