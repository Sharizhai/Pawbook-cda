{
  "name": "pawbook",
  "version": "2.0.0",
  "scripts": {
    "dev:client": "pnpm --filter pawbook-client dev",
    "dev:server": "pnpm --filter pawbook-server dev",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "build:client": "pnpm --filter pawbook-client build",
    "build:server": "pnpm --filter pawbook-server build",
    "start:server": "pnpm --filter pawbook-server start"
  },
  "pnpm": {
    "overrides": {
      "effect": ">=3.20.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "rolldown",
      "@rolldown/binding-linux-x64-gnu",
      "@rolldown/binding-linux-x64-musl"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.3.5",
    "@vitest/coverage-istanbul": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4",
    "jsdom": "^26.1.0",
    "qs": "^6.15.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "sass": "^1.97.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.12",
    "@rolldown/binding-linux-x64-musl": "1.0.0-rc.12"
  }
}