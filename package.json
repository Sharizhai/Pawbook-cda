{
  "name": "pawbook",
  "version": "2.0.0",
  "scripts": {
    "dev:client": "pnpm --filter pawbook-client dev",
    "dev:server": "pnpm --filter pawbook-server dev",
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\"",
    "build:client": "pnpm --filter pawbook-client build",
    "build:server": "pnpm --filter pawbook-server build",
    "start:server": "pnpm --filter pawbook-server start"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=9.0.7",
      "flatted": ">=3.4.2",
      "undici": ">=7.24.0",
      "rollup": ">=4.59.0"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "jsdom": "^28.1.0",
    "qs": "^6.15.0",
    "svelte-preprocess": "^6.0.3",
    "tsx": "^4.21.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "sass": "^1.97.3"
  }
}